    {
      "src": "/buy-online-malawi/",
      "dest": "https://buymesho.onrender.com/buy-online-malawi/"
    },
    {
      "src": "/sell-online-malawi",
      "dest": "https://buymesho.onrender.com/sell-online-malawi"
    },
    {
      "src": "/sell-online-malawi/",
      "dest": "https://buymesho.onrender.com/sell-online-malawi/"
