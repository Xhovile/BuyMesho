    },
    {
      "src": "/sitemap-(.*)\\.xml",
      "dest": "https://buymesho.onrender.com/api/seo/sitemap-$1.xml"
    },
    {
      "src": "/",
      "dest": "https://buymesho.onrender.com/"
    },
    {
      "src": "/home",
      "dest": "https://buymesho.onrender.com/home"
    },
    {
      "src": "/home/",
      "dest": "https://buymesho.onrender.com/home/"
    },
    {
      "src": "/install",
      "dest": "https://buymesho.onrender.com/install"
    },
    {
      "src": "/install/",
      "dest": "https://buymesho.onrender.com/install/"
    },
    {
      "src": "/signup",
      "dest": "https://buymesho.onrender.com/signup"
    },
    {
      "src": "/signup/",
      "dest": "https://buymesho.onrender.com/signup/"
    },
    {
      "src": "/about",
      "dest": "https://buymesho.onrender.com/about"
    },
    {
      "src": "/about/",
      "dest": "https://buymesho.onrender.com/about/"
    },
    {
      "src": "/explore",
      "dest": "https://buymesho.onrender.com/explore"
    },
    {
