{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://buymesho.onrender.com/api/$1"
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "https://buymesho.onrender.com/api/seo/sitemap.xml"
    },
    {
      "src": "/sitemap-(.*)\\.xml",
      "dest": "https://buymesho.onrender.com/api/seo/sitemap-$1.xml"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
