    },
    {
      "src": "/explore/deals/",
      "dest": "https://buymesho.onrender.com/explore/deals/"
    },
    {
      "src": "/explore/events",
      "dest": "https://buymesho.onrender.com/explore/events"
    },
    {
      "src": "/explore/events/",
      "dest": "https://buymesho.onrender.com/explore/events/"
    },
    {
      "src": "/explore/wholesale",
      "dest": "https://buymesho.onrender.com/explore/wholesale"
