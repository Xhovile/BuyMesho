# Optional dedicated signing secret for direct event ticket PDF download links. Falls back to PayChangu secrets.
EVENT_TICKET_DOWNLOAD_SECRET=

# Signed event ticket credentials (server-only private key; never expose the private key to Vite/client code)
BUYMESHO_TICKET_SIGNING_KEY_ID=buymesho-ticket-2026
BUYMESHO_TICKET_SIGNING_PRIVATE_KEY=

# Optional historical ticket verification keys for key rotation.
# JSON object: {"old-key-id":"base64-SPKI-public-key", "older-key-id":"base64-SPKI-public-key"}
# The current signing key is derived from BUYMESHO_TICKET_SIGNING_PRIVATE_KEY.
BUYMESHO_TICKET_VERIFY_PUBLIC_KEYS=
