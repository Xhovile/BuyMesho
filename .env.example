# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Gemini Configuration (server-only; never prefix these with VITE_)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional ordered comma-separated fallback model IDs.
# Keep these pinned to stable models that the production Gemini project can access.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Admin access / RBAC migration (server-only)
# Legacy fallback during migration. Remove after Firebase role claims are verified.
ADMIN_EMAILS=
ADMIN_UIDS=

# Optional role-migration sources. Never commit production identities here.
FINANCE_ADMIN_EMAILS=
FINANCE_ADMIN_UIDS=
MODERATOR_EMAILS=
MODERATOR_UIDS=
SUPPORT_EMAILS=
SUPPORT_UIDS=
VALIDATOR_EMAILS=
VALIDATOR_UIDS=
SELLER_EMAILS=
SELLER_UIDS=
# Explicit migration entries in UID:role format; comma-separated.
# Example: ROLE_MIGRATIONS=uid123:admin,uid456:finance_admin
ROLE_MIGRATIONS=
# Migration is a dry run by default. Set DRY_RUN=false only for the actual claim write.
DRY_RUN=true

# Email Configuration
# Brevo API key is server-only. Never prefix these with VITE_.
BREVO_API_KEY=

# Legacy SMTP configuration. Retained temporarily during migration to Brevo.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="xhovilepublications@gmail.com"
SMTP_FROM_NAME="BuyMesho"
SMTP_REPLY_TO="xhovilepublications@gmail.com"

# PostgreSQL (Aiven)
DATABASE_URL=postgres://USERNAME:PASSWORD@buymesho-buymesho-1.a.aivencloud.com:10285/defaultdb
PGSSLMODE=require
PGSSL_REJECT_UNAUTHORIZED=true
# Preferred production option: paste the Aiven project CA certificate here as a secret.
PGSSL_CA=
# Alternative: path to a readable CA certificate file inside the service filesystem.
# Defaults to ./ca.pem when PGSSL_CA is empty.
PGSSL_CA_PATH=
PGPOOL_MAX=10
PGPOOL_IDLE_TIMEOUT_MS=30000
PGPOOL_CONNECTION_TIMEOUT_MS=10000

# Optional only for tests/local mock scenarios. Do not enable in production.
ALLOW_MOCK_DATABASE=false

# PayChangu Payment Gateway
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_WEBHOOK_URL=
PAYCHANGU_BASE_URL=

# PayChangu Connect
CONNECT_TOKEN_ENCRYPTION_KEY=
VITE_PAYCHANGU_CLIENT_ID=
VITE_PAYCHANGU_MODE=test
VITE_PAYCHANGU_WEBHOOK_URL=
VITE_PAYCHANGU_WEBHOOK_SECRET=

# Seller payout destination encryption
SELLER_PAYOUT_ENCRYPTION_KEY=

# PayChangu seller payout configuration
PAYCHANGU_PAYOUT_BASE_URL=
PAYCHANGU_MOBILE_MONEY_PAYOUT_PATH=/mobile-money/payouts/initialize
PAYCHANGU_BANK_PAYOUT_PATH=/direct-charge/payouts/initialize
PAYCHANGU_PAYOUT_STATUS_PATH=/direct-charge/payouts/{charge_id}/details
PAYCHANGU_MOBILE_MONEY_PATH=/mobile-money
PAYCHANGU_BANKS_PATH=/direct-charge/payouts/supported-banks
PAYCHANGU_PAYOUT_BALANCE_PATH=/wallet-balance
PAYCHANGU_PAYOUT_TIMEOUT_MS=120000
PAYOUT_RECONCILIATION_WORKER_ENABLED=true
PAYOUT_RECONCILIATION_WORKER_INTERVAL_MS=300000
PAYOUT_RECONCILIATION_WORKER_BATCH_LIMIT=25

# Rate-limit diagnostics (server-only)
# Use a dedicated diagnostic token; never reuse an application credential.
RATE_LIMIT_DIAGNOSTIC_TOKEN=
# Optional second BuyMesho instance URL for the distributed Redis test.
RATE_LIMIT_DIAGNOSTIC_PEER_URL=
# Optional Redis URL. When present, the diagnostic runs RedisStore and multi-instance checks.
REDIS_URL=
